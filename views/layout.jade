doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title ? `${title} | Asset Management` : 'Asset Management'
    link(rel="stylesheet", href="/vendor/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet", href="/vendor/bootstrap-icons/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/vendor/datatables-bs5/css/dataTables.bootstrap5.min.css")
    link(rel="stylesheet", href="/css/style.css")
  body
    .app-wrapper
      aside.sidebar
        .sidebar-brand
          .d-flex.align-items-center.gap-2
            i.bi.bi-box-seam-fill.fs-4.text-primary
            div
              .brand-title AssetTrack
              .brand-sub Asset Management
        nav.nav.flex-column.pb-4
          .sidebar-section-label Masters
          a.nav-link(href="/employees", class=(activePage === 'employees' ? 'active' : ''))
            i.bi.bi-people
            span Employee Master
          a.nav-link(href="/assets", class=(activePage === 'assets' ? 'active' : ''))
            i.bi.bi-laptop
            span Asset Master
          a.nav-link(href="/categories", class=(activePage === 'categories' ? 'active' : ''))
            i.bi.bi-tags
            span Asset Category Master
          .sidebar-section-label Inventory & Lifecycle
          a.nav-link(href="/stock", class=(activePage === 'stock' ? 'active' : ''))
            i.bi.bi-building-check
            span Stock View
          a.nav-link(href="/issue", class=(activePage === 'issue' ? 'active' : ''))
            i.bi.bi-box-arrow-up-right
            span Issue Asset
          a.nav-link(href="/return", class=(activePage === 'return' ? 'active' : ''))
            i.bi.bi-arrow-return-left
            span Return Asset
          a.nav-link(href="/scrap", class=(activePage === 'scrap' ? 'active' : ''))
            i.bi.bi-trash3
            span Scrap Asset
          .sidebar-section-label Tracking
          a.nav-link(href="/history", class=(activePage === 'history' ? 'active' : ''))
            i.bi.bi-clock-history
            span Asset History

      main.main-content
        header.topbar
          div
            h5.mb-0.fw-bold= title || 'Asset Management'
          .d-flex.align-items-center.gap-2
            a.btn.btn-sm.btn-outline-primary(href="/issue")
              i.bi.bi-plus-circle.me-1
              | Issue Asset
            a.btn.btn-sm.btn-outline-secondary(href="/return")
              i.bi.bi-arrow-return-left.me-1
              | Return Asset

        section.page-body
          if alert
            .alert.alert-dismissible.fade.show(class=`alert-${alert.type}`, role="alert")
              = alert.message
              button.btn-close(type="button", data-bs-dismiss="alert", aria-label="Close")
          block content

    script(src="/vendor/jquery/jquery.min.js")
    script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/vendor/datatables/dataTables.min.js")
    script(src="/vendor/datatables-bs5/js/dataTables.bootstrap5.min.js")
    script(src="/js/app.js")
    block scripts
