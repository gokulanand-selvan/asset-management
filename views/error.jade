extends layout.jade

block content
  .card.mx-auto(style="max-width: 600px;")
    .card-body.text-center.py-5
      h1.display-4.fw-bold.text-danger= statusCode || 500
      h4.mb-3= title || 'Error'
      p.text-muted.mb-4= message
      a.btn.btn-primary(href="/")
        i.bi.bi-house.me-1
        | Back to Dashboard
