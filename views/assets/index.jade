extends ../layout.jade

block content
  .card.mb-4
    .card-body
      form.row.g-3.align-items-end(method="GET", action="/assets")
        .col-md-4
          label.form-label.small.fw-semibold Asset Type / Category
          select.form-select(name="categoryId")
            option(value="all", selected=(filters.categoryId === 'all')) All Asset Types
            each cat in categories
              option(value=cat.id, selected=(String(cat.id) === String(filters.categoryId)))= cat.name
        .col-md-4.d-flex.gap-2
          button.btn.btn-primary(type="submit")
            i.bi.bi-funnel.me-1
            | Filter
          a.btn.btn-outline-secondary(href="/assets") Reset
        .col-md-4.text-md-end
          button.btn.btn-success(type="button", data-bs-toggle="modal", data-bs-target="#addAssetModal")
            i.bi.bi-plus-lg.me-1
            | Add Asset

  .card
    .card-header
      i.bi.bi-laptop.me-2.text-primary
      | Assets (#{assets.length})
    .card-body
      .table-responsive
        table#assetsTable.table.table-hover.align-middle.datatable(data-order-col="0")
          thead
            tr
              th Unique ID
              th Serial No.
              th Asset Type
              th Make & Model
              th Branch
              th.text-end Purchase Cost
              th Status
              th Assigned To
              th.text-end Actions
          tbody
            each asset in assets
              tr
                td
                  a.code-pill.text-decoration-none(href=`/history/${asset.id}`)= asset.assetTag
                td.font-monospace.small= asset.serialNumber
                td= asset.category ? asset.category.name : '-'
                td
                  .fw-semibold #{asset.make} #{asset.model}
                  .small.text-muted Purchased #{asset.purchaseDate}
                td= asset.branch
                td.text-end= formatCurrency(asset.purchaseCost)
                td
                  span.badge.badge-status(class=`badge-${asset.status}`)= formatStatusLabel(asset.status)
                td= asset.currentEmployee ? `${asset.currentEmployee.firstName} ${asset.currentEmployee.lastName}` : '-'
                td.text-end
                  .btn-group.btn-group-sm
                    a.btn.btn-outline-secondary(href=`/history/${asset.id}`, title="View History")
                      i.bi.bi-clock-history
                    button.btn.btn-outline-primary.btn-edit-asset(
                      type="button",
                      data-bs-toggle="modal",
                      data-bs-target="#editAssetModal",
                      data-id=asset.id,
                      data-tag=asset.assetTag,
                      data-serial=asset.serialNumber,
                      data-categoryid=asset.categoryId,
                      data-branch=asset.branch,
                      data-make=asset.make,
                      data-model=asset.model,
                      data-purchasedate=asset.purchaseDate,
                      data-purchasecost=asset.purchaseCost,
                      data-warranty=(asset.warrantyExpiry || ''),
                      data-notes=(asset.notes || ''),
                      title="Edit Asset"
                    )
                      i.bi.bi-pencil

  datalist#branchList
    each b in branches
      option(value=b)

  // Add Asset Modal
  #addAssetModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content
        form(method="POST", action="/assets")
          .modal-header
            h5.modal-title Add Asset
            button.btn-close(type="button", data-bs-dismiss="modal")
          .modal-body
            .row.g-3
              .col-md-4
                label.form-label Unique Asset ID *
                input.form-control(type="text", name="assetTag", placeholder="AST-1010", required)
              .col-md-4
                label.form-label Serial Number *
                input.form-control(type="text", name="serialNumber", placeholder="SN-XYZ-9910", required)
              .col-md-4
                label.form-label Asset Category *
                select.form-select(name="categoryId", required)
                  each cat in categories
                    option(value=cat.id)= cat.name
              .col-md-4
                label.form-label Make *
                input.form-control(type="text", name="make", placeholder="Apple / Dell / Bosch", required)
              .col-md-4
                label.form-label Model *
                input.form-control(type="text", name="model", placeholder="MacBook Pro 14", required)
              .col-md-4
                label.form-label Branch *
                input.form-control(type="text", name="branch", list="branchList", placeholder="Head Office", required)
              .col-md-4
                label.form-label Purchase Date *
                input.form-control(type="date", name="purchaseDate", value=today, required)
              .col-md-4
                label.form-label Purchase Cost *
                input.form-control(type="number", step="0.01", min="0", name="purchaseCost", required)
              .col-md-4
                label.form-label Warranty Expiry
                input.form-control(type="date", name="warrantyExpiry")
              .col-12
                label.form-label Notes
                textarea.form-control(name="notes", rows="2")
          .modal-footer
            button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Cancel
            button.btn.btn-primary(type="submit") Save Asset

  // Edit Asset Modal
  #editAssetModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content
        form#editAssetForm(method="POST", action="/assets/0")
          .modal-header
            h5.modal-title Edit Asset
            button.btn-close(type="button", data-bs-dismiss="modal")
          .modal-body
            .row.g-3
              .col-md-4
                label.form-label Unique Asset ID *
                input#editAssetTag.form-control(type="text", name="assetTag", required)
              .col-md-4
                label.form-label Serial Number *
                input#editAssetSerial.form-control(type="text", name="serialNumber", required)
              .col-md-4
                label.form-label Asset Category *
                select#editAssetCategory.form-select(name="categoryId", required)
                  each cat in categories
                    option(value=cat.id)= cat.name
              .col-md-4
                label.form-label Make *
                input#editAssetMake.form-control(type="text", name="make", required)
              .col-md-4
                label.form-label Model *
                input#editAssetModel.form-control(type="text", name="model", required)
              .col-md-4
                label.form-label Branch *
                input#editAssetBranch.form-control(type="text", name="branch", list="branchList", required)
              .col-md-4
                label.form-label Purchase Date *
                input#editAssetPurchaseDate.form-control(type="date", name="purchaseDate", required)
              .col-md-4
                label.form-label Purchase Cost *
                input#editAssetPurchaseCost.form-control(type="number", step="0.01", min="0", name="purchaseCost", required)
              .col-md-4
                label.form-label Warranty Expiry
                input#editAssetWarranty.form-control(type="date", name="warrantyExpiry")
              .col-12
                label.form-label Notes
                textarea#editAssetNotes.form-control(name="notes", rows="2")
          .modal-footer
            button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Cancel
            button.btn.btn-primary(type="submit") Update Asset
