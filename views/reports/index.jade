extends ../layout.jade

block content
  .row.g-3.mb-4
    .col-sm-6.col-xl-4
      .card.kpi-card
        .card-body
          .kpi-label Total Investment
          .kpi-value= formatCurrency(summary.totalPurchaseCost)
          .small.text-muted #{summary.activeCount} active • #{summary.scrappedCount} scrapped
    .col-sm-6.col-xl-4
      .card.kpi-card.kpi-success
        .card-body
          .kpi-label Salvage Recovered
          .kpi-value= formatCurrency(summary.totalSalvageValue)
          .small.text-muted From scrapped assets
    .col-sm-6.col-xl-4
      .card.kpi-card.kpi-danger
        .card-body
          .kpi-label Scrapped Net Write-Off
          .kpi-value= formatCurrency(summary.scrappedWriteOff)
          .small.text-muted #{summary.scrappedCount} obsolete asset(s)

  // Scrapped Assets Report (Only place scrapped assets are visible)
  .card.mb-4
    .card-header.d-flex.justify-content-between.align-items-center
      span.text-danger
        i.bi.bi-trash3-fill.me-2
        | Scrapped / Obsolete Assets Report (#{scrappedRows.length})
      span.small.text-muted Visible exclusively in Reports
    .card-body
      .table-responsive
        table#reportsScrappedTable.table.table-hover.align-middle.datatable(data-order-col="4", data-order-dir="desc")
          thead
            tr
              th Unique ID
              th Serial No.
              th Category
              th Make & Model
              th Scrap Date
              th Reason
              th.text-end Purchase Cost
              th.text-end Salvage Value
              th.text-end Net Write-Off
              th.text-end Utilization
              th.text-end History
          tbody
            each row in scrappedRows
              - const a = row.asset
              - const m = row.metrics
              tr
                td
                  span.code-pill= a.assetTag
                td.font-monospace.small= a.serialNumber
                td= a.category ? a.category.name : '-'
                td #{a.make} #{a.model}
                td= a.scrappedAt || '-'
                td= a.scrapReason || '-'
                td.text-end= formatCurrency(m.purchaseCost)
                td.text-end= formatCurrency(m.salvageValue)
                td.text-end.fw-semibold= formatCurrency(m.netCost)
                td.text-end #{m.utilizationPercent}%
                td.text-end
                  a.btn.btn-sm.btn-outline-primary(href=`/reports/history/${a.id}`) Lifecycle

  // All Assets Utilization Report
  .card
    .card-header
      i.bi.bi-bar-chart-line.me-2.text-primary
      | Asset Utilization & Investment Report (#{utilizationRows.length})
    .card-body
      .table-responsive
        table#reportsUtilizationTable.table.table-hover.align-middle.datatable(data-order-col="0")
          thead
            tr
              th Unique ID
              th Asset
              th Category
              th Branch
              th Status
              th.text-end Days Owned
              th.text-end Days Issued
              th.text-end Utilization
              th.text-end Purchase Cost
              th.text-end Net Cost
              th.text-end History
          tbody
            each row in utilizationRows
              - const a = row.asset
              - const m = row.metrics
              tr
                td
                  span.code-pill= a.assetTag
                td
                  .fw-semibold #{a.make} #{a.model}
                  .small.text-muted.font-monospace= a.serialNumber
                td= a.category ? a.category.name : '-'
                td= a.branch
                td
                  span.badge.badge-status(class=`badge-${a.status}`)= formatStatusLabel(a.status)
                td.text-end= m.totalOwnershipDays
                td.text-end= m.daysIssued
                td.text-end #{m.utilizationPercent}%
                td.text-end= formatCurrency(m.purchaseCost)
                td.text-end.fw-semibold= formatCurrency(m.netCost)
                td.text-end
                  a.btn.btn-sm.btn-outline-secondary(href=`/reports/history/${a.id}`) View
          tfoot
            tr
              th(colspan="8").text-end Totals:
              th.text-end= formatCurrency(summary.totalPurchaseCost)
              th.text-end= formatCurrency(summary.totalNetCost)
              th
